<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0,Profile=Client" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="PublishServiceSoap">
                    <security mode="Transport" />
                </binding>
                <binding name="PublishServiceSoap1" />
                <binding name="PortalServiceSoap">
                    <security mode="Transport" />
                </binding>
                <binding name="PortalServiceSoap1" />
                <binding name="BusinessServiceSoap">
                    <security mode="Transport" />
                </binding>
                <binding name="BusinessServiceSoap1" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://saigonotocanthoadmindemo.vnpt-invoice.com.vn/publishservice.asmx"
                binding="basicHttpBinding" bindingConfiguration="PublishServiceSoap"
                contract="ServiceReference1.PublishServiceSoap" name="PublishServiceSoap" />
            <endpoint address="https://saigonotocanthoadmindemo.vnpt-invoice.com.vn/portalservice.asmx"
                binding="basicHttpBinding" bindingConfiguration="PortalServiceSoap"
                contract="ServiceReference2.PortalServiceSoap" name="PortalServiceSoap" />
            <endpoint address="https://saigonotocanthoadmindemo.vnpt-invoice.com.vn/businessservice.asmx"
                binding="basicHttpBinding" bindingConfiguration="BusinessServiceSoap"
                contract="ServiceReference3.BusinessServiceSoap" name="BusinessServiceSoap" />
        </client>
    </system.serviceModel>
</configuration>